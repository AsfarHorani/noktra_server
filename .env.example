# Copy this file to .env and fill in real values. .env is gitignored —
# never commit it. Everything here has a safe local-dev default in
# settings.py, so .env is optional for local development; it matters once
# you'd ever run this somewhere the defaults aren't appropriate.

# Generate a real one for anything beyond throwaway local dev:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True for local dev. Set to False if this ever runs anywhere reachable
# beyond your own machine.
DEBUG=True

# Comma-separated. This server is designed to run locally alongside the
# extension only — never deployed — so the default (127.0.0.1,localhost)
# is normally all you need.
ALLOWED_HOSTS=127.0.0.1,localhost

# Ollama connection — override to point at a different instance/model.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
